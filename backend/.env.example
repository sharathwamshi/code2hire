# --- Flask ---
SECRET_KEY=change-this-secret-in-prod
JWT_SECRET_KEY=change-this-jwt-secret-in-prod
FLASK_PORT=5050
FRONTEND_ORIGIN=http://localhost:5174

# --- MySQL ---
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=acknowledgermate
# Or set the full URI directly instead of the pieces above:
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/acknowledgermate

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Interview integrity defaults ---
DEFAULT_VIOLATION_THRESHOLD=1

# --- Default admin (created by seed.py, first run only) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
